# Mail delivery — server-only variables (never expose to client bundles).
# Default production provider is Resend.
MAIL_PROVIDER=resend

# Resend (primary)
RESEND_API_KEY=
MAIL_FROM=Mogen <info@mogen.co.za>
MAIL_TO=info@mogen.co.za

# Google SMTP (secondary, App Password — requires Google 2-Step Verification)
# MAIL_PROVIDER=google-smtp
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURE=true
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=

# Cloudflare Turnstile — contact form bot protection.
# Site key is public; the secret below is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret from dash.cloudflare.com → Turnstile → widget Settings.
# Copy into local .env / hosting secret store. NEVER commit a value here.
TURNSTILE_SECRET=
# Comma-separated frontend hostnames siteverify must accept.
# Local dev: localhost,127.0.0.1
# Production (Vercel): www.mogen.co.za — must NOT include localhost.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# SEO analyser reports — inbox for full technical PDFs.
# The client PDF goes to the visitor's own email address; the technical
# PDF always goes here, on every completed audit (domain + visitor IP),
# and again with lead details when the form is completed.
SEO_REPORT_TO=info@mogen.co.za

# Google PageSpeed Insights API v5 — server-only Lighthouse lab evidence.
# Used exclusively by server-side audit code (lib/audit/pagespeed.ts via
# process.env.PAGESPEED_API_KEY). NEVER expose as NEXT_PUBLIC_, never log
# it, never return it in API responses, and never commit a real value.
# Copy the real key into local .env and Vercel/server environment config
# (all deployment environments that run /api/audit).
PAGESPEED_API_KEY=

# Google Analytics 4 (GA4) - public measurement ID, exposed to the browser.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public site URL — canonical base for metadata, OG, JSON-LD, sitemap, robots.
# Development/preview: NEXT_PUBLIC_SITE_URL=https://mogen-v4.vercel.app
# Production: NEXT_PUBLIC_SITE_URL=https://www.mogen.co.za
# When unset, the application defaults to the production URL.
# NEXT_PUBLIC_SITE_URL=

# Promotions — homepage fallback featuring kill switch (server-only).
# "true" lets an active but unfeatured promotion fill the homepage slot when
# none is explicitly featured; anything else (including unset) disables it.
# Read at request/regeneration time, so flipping it takes effect on next ISR
# regeneration without a redeploy. NEVER expose as NEXT_PUBLIC_.
MOGEN_ALLOW_FALLBACK_FEATURING=false

# Pagination — site-wide listing controls (server-only, read at request /
# regeneration time, so flips apply on next ISR regeneration, no redeploy).
# NEVER expose as NEXT_PUBLIC_.
# Items per page (positive integer; default 12 when unset or invalid).
# PAGINATION_PAGE_SIZE=12
# One section may override the size without affecting the rest of the site
# (e.g. articles only). Layout and boundary behaviour stay global so every
# paginated section keeps one design language.
# PAGINATION_ARTICLES_PAGE_SIZE=6
# Row layout: "condensed" (default) centres every control in one row;
# "justified" spreads the three groups — (First, Previous), page numbers,
# (Next, Last) — across the full row width.
# PAGINATION_STYLE=condensed
# Boundary behaviour for First/Previous/Next/Last: "disabled" (default)
# always renders them and shows unreachable ones as disabled
# (layout-stable); "smart" omits controls that would go nowhere instead.
# PAGINATION_ENDS=disabled

# Article hero slideshow — fade interval between multiple hero images (ms).
# Build-time (NEXT_PUBLIC_) setting — set before running the build; default 5000ms when unset.
# NEXT_PUBLIC_ARTICLE_HERO_SLIDESHOW_INTERVAL_MS=5000

# Articles — entity linking controls (server-side script only, read from the
# environment when `pnpm articles:link` runs; no redeploy needed).
# NEVER expose as NEXT_PUBLIC_.
# Max frontmatter tags per article (positive integer; default 8 when unset
# or invalid). The linker only ADDS tags up to this total — manually added
# tags beyond the limit stay untouched and block further additions.
# ARTICLES_MAX_TAGS=8

# Rampify server-side tracker (proxy.ts) — bot/LLM-fetcher pageviews.
# Server-only key from the Rampify dashboard → Settings → Server tracker.
# Copy the real key into local .env and Vercel env vars. NEVER commit a
# value here, never expose as NEXT_PUBLIC_. Without it, proxy.ts is a
# transparent pass-through and only the client-side tracker.js runs.
# RAMPIFY_API_KEY=
# Optional collect-endpoint override (defaults to Rampify production).
# RAMPIFY_API_URL=
NEXT_PUBLIC_RAMPIFY_TRACKER_ID=

# AHrefs
NEXT_PUBLIC_AHREFS_ANALYTICS_ID=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=