# Mail delivery — server-only variables (never expose to client bundles).
# Default production provider is Resend.
MAIL_PROVIDER=resend

# Resend (primary)
RESEND_API_KEY=
MAIL_FROM=Mogen <info@mogen.co.za>
MAIL_TO=info@mogen.co.za

# Google SMTP (secondary, App Password — requires Google 2-Step Verification)
# MAIL_PROVIDER=google-smtp
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURE=true
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=

# Cloudflare Turnstile — contact form bot protection.
# Site key is public; the secret below is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret from dash.cloudflare.com → Turnstile → widget Settings.
# Copy into local .env / hosting secret store. NEVER commit a value here.
TURNSTILE_SECRET=
# Comma-separated frontend hostnames siteverify must accept.
# Local dev: localhost,127.0.0.1
# Production (Vercel): www.mogen.co.za — must NOT include localhost.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
