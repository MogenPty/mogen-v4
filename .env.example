# Mail delivery — server-only variables (never expose to client bundles).
# Default production provider is Resend.
MAIL_PROVIDER=resend

# Resend (primary)
RESEND_API_KEY=
MAIL_FROM=Mogen <info@mogen.co.za>
MAIL_TO=info@mogen.co.za

# Google SMTP (secondary, App Password — requires Google 2-Step Verification)
# MAIL_PROVIDER=google-smtp
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURE=true
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
